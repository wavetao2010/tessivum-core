{
  "schemaVersion": "tessivum.conformance/v1",
  "name": "loader.core-catalog",
  "domain": "loader",
  "scenario": "loader-catalog",
  "input": {
    "cases": [
      {"id": "unordered-dependencies", "entries": ["consumer", "provider"], "requires": {"consumer": ["provider"]}},
      {"id": "duplicate-id", "entries": ["duplicate", "duplicate"]},
      {"id": "add-update-remove-move", "operations": ["add", "update", "remove", "move"]},
      {"id": "config-only-update", "operations": ["update-config"]},
      {"id": "plugin-replacement", "operations": ["replace-plugin"]},
      {"id": "candidate-failure", "candidate": "throws"},
      {"id": "rollback-failure", "candidate": "throws", "rollback": "throws"},
      {"id": "nested-group", "groups": ["root", "root.child"]},
      {"id": "patch-insertion-later-targeting", "operations": ["insert-patch", "target-patch"]},
      {"id": "atomic-write", "write": "atomic"}
    ]
  },
  "expectedTrace": [
    {"event": "config-committed", "subject": "unordered-dependencies", "phase": "catalog", "value": {"consumerActive": true}},
    {"event": "config-committed", "subject": "duplicate-id", "phase": "catalog", "value": {"duplicateRejected": true}},
    {"event": "config-committed", "subject": "add-update-remove-move", "phase": "catalog", "value": {"ids": ["third", "second"]}},
    {"event": "config-committed", "subject": "config-only-update", "phase": "catalog", "value": {"revision": 2}},
    {"event": "config-committed", "subject": "plugin-replacement", "phase": "catalog", "value": {"active": "replacement"}},
    {"event": "config-committed", "subject": "candidate-failure", "phase": "catalog", "value": {"tree": "old"}},
    {"event": "config-committed", "subject": "rollback-failure", "phase": "catalog", "value": {"tree": "old", "rollbackFailed": true}},
    {"event": "config-committed", "subject": "nested-group", "phase": "catalog", "value": {"activeEntries": 1}},
    {"event": "config-committed", "subject": "patch-insertion-later-targeting", "phase": "catalog", "value": {"patched": true}},
    {"event": "config-committed", "subject": "atomic-write", "phase": "catalog", "value": {"persisted": true}}
  ]
}
