    {"event": "effect-disposed", "subject": "reverse-disposal", "phase": "catalog", "value": {"order": ["second", "first"]}},
    {"event": "effect-disposed", "subject": "repeated-disposal", "phase": "catalog", "value": {"calls": 1}},
